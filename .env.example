# ============================================================
# BACKEND (.env файлы жоба түбірінде, Render-ге ЖІБЕРІЛМЕЙДІ,
# нақты мәндер тек Render Dashboard -> Environment бөлімінде)
# ============================================================

# MongoDB Atlas connection string. Render дегенде осыны Environment
# Variables ішіне қосасың.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/nashe_sozvezdie?retryWrites=true&w=majority"

# Frontend-тің (Vercel) домені. Бэкендтің CORS саясаты осы доменнен
# келген сұрауларды ғана рұқсат етеді. Бірнеше домен болса, үтірмен
# ажырат: "https://app.vercel.app,https://app-git-preview.vercel.app"
CORS_ORIGIN="https://your-frontend.vercel.app"

# Render өзі PORT айнымалысын автоматты түрде береді - мұны тек
# локальде (npm run dev:server) іске қосу үшін керек, Render-де
# қоюдың қажеті жоқ.
PORT=3001

# ------------------------------------------------------------
# Telegram еске салғыштар (міндетті емес — толтырылмаса, жай
# сөндірулі болады, сайт өз қалпында жұмыс істей береді)
# ------------------------------------------------------------
# 1) Telegram-да @BotFather-ге барып /newbot жаз, ол саған токен береді
# 2) Еске салынатын адам сол ботқа бір рет /start жазсын
# 3) Браузерде мынаны аш: https://api.telegram.org/bot<TOKEN>/getUpdates
#    — жауаптағы "chat":{"id": ...} деген сан TELEGRAM_CHAT_ID болады
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Кешкі 20:00-де "әлі ойнаған жоқсың" еске салғышы тек осы поштаның
# прогресін тексереді (оның аккаунт email-і, яғни UserProgress.userId).
TELEGRAM_WATCH_USER_EMAIL=""

# Еске салғыштар қай жергілікті уақыт бойынша жіберілетінін анықтайды
# (сервердің өз уақыт белдеуіне тәуелді емес).
APP_TIMEZONE="Asia/Almaty"

# ============================================================
# FRONTEND (Vercel Dashboard -> Settings -> Environment Variables)
# ============================================================

# Render-ге деплой болған backend-тің толық URL мекенжайы.
# Соңында слэш "/" болмасын.
VITE_API_URL="https://your-backend.onrender.com"
